{
  "name": "edutara-cbt",
  "version": "0.1.0",
  "private": true,
  "description": "Fondasi pembangunan ulang EDUTARA CBT dengan Next.js dan TypeScript",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
